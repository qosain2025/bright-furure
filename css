/* ==========================================================================
   BRIGHT FUTURE ACADEMY (BFA) - MODERN ANIMATED DESIGN SYSTEM
   Chakswari, Azad Kashmir | IELTS & IT Courses
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. CSS VARIABLES & THEME SETUP
   -------------------------------------------------------------------------- */
:root {
  /* Brand Palette */
  --blue-primary: #0066cc;
  --blue-hover: #0052a3;
  --blue-dark: #072a59;
  --blue-deep: #051937;
  --blue-light: #e8f3fc;
  --blue-subtle: #f0f7fe;
  --blue-glow: rgba(0, 102, 204, 0.35);

  --accent-cyan: #00d2ff;
  --accent-emerald: #10b981;
  --accent-amber: #f59e0b;
  --whatsapp-green: #25d366;
  --whatsapp-dark: #128c7e;

  /* Neutral Shades */
  --navy: #081d3d;
  --navy-dark: #040f22;
  --text-main: #182d49;
  --text-muted: #5e738d;
  --text-light: #94a3b8;
  --border: #dce7f3;
  --border-light: #edf3f9;
  --surface: #ffffff;
  --surface-alt: #f8fbfe;

  /* Elevated Shadows */
  --shadow-sm: 0 4px 12px rgba(8, 29, 61, 0.05);
  --shadow-md: 0 10px 25px -4px rgba(8, 29, 61, 0.08), 0 6px 12px -4px rgba(8, 29, 61, 0.03);
  --shadow-lg: 0 20px 40px -10px rgba(0, 102, 204, 0.14), 0 8px 16px -6px rgba(8, 29, 61, 0.06);
  --shadow-xl: 0 30px 60px -15px rgba(8, 29, 61, 0.16);
  --shadow-glow: 0 0 30px rgba(0, 102, 204, 0.25);

  /* Radius */
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  --radius-full: 9999px;

  /* Transitions */
  --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-slow: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* --------------------------------------------------------------------------
   2. GLOBAL BASE & RESET
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text-main);
  background-color: #ffffff;
  line-height: 1.65;
  font-size: 16px;
  overflow-x: hidden;
  position: relative;
}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  color: var(--navy);
  font-weight: 700;
  line-height: 1.2;
}

a {
  text-decoration: none;
  color: inherit;
  transition: color var(--transition-fast);
}

img, svg {
  max-width: 100%;
  display: block;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}
::-webkit-scrollbar-track {
  background: #f1f5f9;
}
::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 5px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--blue-primary);
}

/* Selection Color */
::selection {
  background: #c7e2fe;
  color: var(--blue-dark);
}

.container {
  width: min(1200px, 92%);
  margin: 0 auto;
}

/* --------------------------------------------------------------------------
   3. KEYFRAME ANIMATIONS
   -------------------------------------------------------------------------- */
@keyframes floatGentle {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes floatRotate {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-8px) rotate(2deg); }
}

@keyframes pulseGlow {
  0%, 100% { opacity: 0.45; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.08); }
}

@keyframes radarPing {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
  70% { transform: scale(1.02); box-shadow: 0 0 0 16px rgba(37, 211, 102, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
}

@keyframes liveDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes shimmerEffect {
  0% { transform: translateX(-150%); }
  100% { transform: translateX(150%); }
}

/* --------------------------------------------------------------------------
   4. SCROLL REVEAL UTILITIES
   -------------------------------------------------------------------------- */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

.reveal.reveal-left {
  transform: translateX(-40px);
}

.reveal.reveal-right {
  transform: translateX(40px);
}

.reveal.reveal-scale {
  transform: scale(0.92);
}

.reveal.show {
  opacity: 1;
  transform: translate(0) scale(1);
}

/* Stagger delay classes */
.delay-1 { transition-delay: 0.1s; }
.delay-2 { transition-delay: 0.2s; }
.delay-3 { transition-delay: 0.3s; }
.delay-4 { transition-delay: 0.4s; }
.delay-5 { transition-delay: 0.5s; }

/* --------------------------------------------------------------------------
   5. TOPBAR
   -------------------------------------------------------------------------- */
.topbar {
  background: var(--blue-deep);
  color: #dbeafe;
  font-size: 13px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  font-weight: 500;
  position: relative;
  z-index: 1001;
}

.topbar .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.topbar-left, .topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.topbar-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #e2e8f0;
}

.topbar-item svg {
  width: 15px;
  height: 15px;
  fill: var(--accent-cyan);
  flex-shrink: 0;
}

.topbar-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(0, 210, 255, 0.15);
  color: #7dd3fc;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 11.5px;
  font-weight: 700;
  border: 1px solid rgba(0, 210, 255, 0.3);
}

.topbar-badge .live-dot {
  width: 7px;
  height: 7px;
  background: #22c55e;
  border-radius: 50%;
  animation: liveDot 1.5s infinite;
}

.topbar a:hover {
  color: #ffffff;
  text-decoration: underline;
}

/* --------------------------------------------------------------------------
   6. HEADER & NAVIGATION
   -------------------------------------------------------------------------- */
header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
  transition: all var(--transition-smooth);
}

header.scrolled {
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10px 30px -10px rgba(7, 42, 89, 0.12);
  border-bottom-color: rgba(220, 231, 243, 0.7);
}

.nav {
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  transition: height var(--transition-fast);
}

header.scrolled .nav {
  height: 68px;
}

.logo-link {
  display: flex;
  align-items: center;
  transition: transform var(--transition-fast);
}

.logo-link:hover {
  transform: scale(1.02);
}

.logo {
  height: 48px;
  width: auto;
  object-fit: contain;
}

.navlinks {
  display: flex;
  align-items: center;
  gap: 26px;
  font-weight: 600;
  font-size: 14.5px;
}

.navlinks a {
  color: var(--navy);
  position: relative;
  padding: 6px 0;
  transition: color var(--transition-fast);
}

.navlinks a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0%;
  height: 2.5px;
  background: linear-gradient(90deg, var(--blue-primary), var(--accent-cyan));
  border-radius: var(--radius-full);
  transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.navlinks a:hover {
  color: var(--blue-primary);
}

.navlinks a:hover::after,
.navlinks a.active::after {
  width: 100%;
}

.navlinks a.active {
  color: var(--blue-primary);
  font-weight: 700;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

/* Mobile Menu Toggle Button */
.menu-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: var(--navy);
  border-radius: var(--radius-sm);
  transition: background-color var(--transition-fast);
}

.menu-btn:hover {
  background: var(--blue-light);
}

.hamburger {
  width: 26px;
  height: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
}

.hamburger span {
  display: block;
  height: 2.5px;
  width: 100%;
  background: var(--navy);
  border-radius: 4px;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transform-origin: center;
}

.menu-btn.open .hamburger span:nth-child(1) {
  transform: translateY(7.5px) rotate(45deg);
}
.menu-btn.open .hamburger span:nth-child(2) {
  opacity: 0;
  transform: scaleX(0);
}
.menu-btn.open .hamburger span:nth-child(3) {
  transform: translateY(-7.5px) rotate(-45deg);
}

/* --------------------------------------------------------------------------
   7. BUTTONS & INTERACTIVE ELEMENTS
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 24px;
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 14.5px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all var(--transition-fast);
  text-align: center;
  position: relative;
  overflow: hidden;
  line-height: 1.2;
}

.btn svg {
  width: 17px;
  height: 17px;
  transition: transform var(--transition-fast);
}

.btn:hover svg {
  transform: translateX(4px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--blue-primary) 0%, #0879e6 100%);
  color: #ffffff;
  box-shadow: 0 8px 20px rgba(0, 102, 204, 0.28);
}

.btn-primary:hover {
  background: linear-gradient(135deg, #0056b3 0%, #0066cc 100%);
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(0, 102, 204, 0.38);
  color: #ffffff;
}

.btn-primary::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
  transform: translateX(-150%);
  transition: transform 0.6s ease;
}

.btn-primary:hover::after {
  transform: translateX(150%);
}

.btn-outline {
  border-color: var(--blue-primary);
  color: var(--blue-primary);
  background: #ffffff;
}

.btn-outline:hover {
  background: var(--blue-light);
  transform: translateY(-2px);
  border-color: var(--blue-primary);
}

.btn-white {
  background: #ffffff;
  color: var(--blue-primary);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}

.btn-white:hover {
  background: #f8fbfe;
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.18);
  color: var(--blue-hover);
}

.btn-whatsapp {
  background: linear-gradient(135deg, #25d366 0%, #1da851 100%);
  color: #ffffff;
  box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
}

.btn-whatsapp:hover {
  background: linear-gradient(135deg, #1ebc59 0%, #189748 100%);
  transform: translateY(-2px);
  box-shadow: 0 12px 26px rgba(37, 211, 102, 0.42);
  color: #ffffff;
}

/* --------------------------------------------------------------------------
   8. HERO SECTION (HOME)
   -------------------------------------------------------------------------- */
.hero {
  position: relative;
  background: radial-gradient(circle at 10% 20%, #eaf4fd 0%, #f4f9fe 50%, #e7f2fd 100%);
  padding: 85px 0 95px;
  overflow: hidden;
}

/* Ambient Glowing Background Orbs */
.hero::before {
  content: "";
  position: absolute;
  top: -150px;
  right: -100px;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 162, 255, 0.18) 0%, rgba(0, 102, 204, 0) 70%);
  pointer-events: none;
  animation: pulseGlow 6s ease-in-out infinite alternate;
}

.hero::after {
  content: "";
  position: absolute;
  bottom: -150px;
  left: 5%;
  width: 450px;
  height: 450px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.15) 0%, rgba(0, 102, 204, 0) 70%);
  pointer-events: none;
  animation: pulseGlow 8s ease-in-out infinite alternate-reverse;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 50px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-content {
  position: relative;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--blue-primary);
  font-weight: 800;
  background: rgba(0, 102, 204, 0.08);
  padding: 6px 16px;
  border-radius: var(--radius-full);
  margin-bottom: 18px;
  border: 1px solid rgba(0, 102, 204, 0.15);
}

.eyebrow-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--blue-primary);
}

.hero h1 {
  font-size: clamp(38px, 4.8vw, 64px);
  line-height: 1.1;
  color: var(--navy);
  margin-bottom: 12px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.text-gradient {
  background: linear-gradient(135deg, var(--blue-primary) 0%, #0099ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subhead {
  font-size: clamp(20px, 2.5vw, 26px);
  font-weight: 600;
  color: var(--blue-hover);
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.rotator-wrapper {
  display: inline-block;
  color: var(--blue-primary);
  border-bottom: 2px solid var(--accent-cyan);
  padding-bottom: 2px;
  transition: opacity 0.3s ease;
  min-width: 180px;
}

.hero p {
  font-size: 17.5px;
  color: var(--text-muted);
  max-width: 580px;
  line-height: 1.7;
}

.hero-features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15px 25px;
  margin-top: 22px;
  list-style: none;
}

.hero-features-list li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14.5px;
  font-weight: 600;
  color: var(--navy);
}

.hero-features-list svg {
  width: 17px;
  height: 17px;
  fill: var(--accent-emerald);
  flex-shrink: 0;
}

.actions {
  display: flex;
  gap: 14px;
  margin-top: 32px;
  flex-wrap: wrap;
  align-items: center;
}

/* Hero Showcase Graphic on Right */
.hero-art {
  min-height: 440px;
  border-radius: var(--radius-xl);
  background: linear-gradient(145deg, #0a3d7a 0%, #0066cc 60%, #008be8 100%);
  position: relative;
  box-shadow: var(--shadow-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 30px;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-art-bg-circle {
  position: absolute;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
  top: -80px;
  right: -60px;
  pointer-events: none;
}

.hero-art-bg-circle-2 {
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.2) 0%, rgba(0, 210, 255, 0) 70%);
  bottom: 80px;
  left: -50px;
  pointer-events: none;
}

/* Floating Elements Inside/Outside Hero Card */
.cap-floating {
  position: absolute;
  top: 10%;
  left: 9%;
  font-size: 64px;
  filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.3));
  animation: floatGentle 4s ease-in-out infinite;
  user-select: none;
}

.floating-badge {
  position: absolute;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 10px 16px;
  border-radius: var(--radius-md);
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--navy);
  border: 1px solid rgba(255, 255, 255, 0.8);
  z-index: 5;
}

.floating-badge-top {
  top: 14%;
  right: 6%;
  animation: floatRotate 5s ease-in-out infinite;
}

.floating-badge-mid {
  top: 40%;
  left: 6%;
  animation: floatGentle 5.5s ease-in-out infinite 0.5s;
}

.floating-badge-icon {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  font-size: 18px;
  flex-shrink: 0;
}

.hero-card {
  position: relative;
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-lg);
  padding: 26px;
  box-shadow: 0 20px 45px rgba(5, 25, 55, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.85);
  z-index: 4;
}

.hero-card-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #dcfce7;
  color: #15803d;
  font-size: 12px;
  font-weight: 800;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  margin-bottom: 12px;
}

.hero-card-status .status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  animation: liveDot 1.2s infinite;
}

.hero-card h3 {
  font-size: 22px;
  color: var(--navy);
  margin-bottom: 6px;
}

.hero-card p {
  font-size: 14px;
  color: var(--text-muted);
  margin-bottom: 14px;
  line-height: 1.5;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 16px;
}

.hero-tags span {
  background: var(--blue-light);
  color: var(--blue-primary);
  font-size: 11.5px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: var(--radius-full);
}

.hero-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border-light);
  padding-top: 14px;
}

.hero-card-footer .link {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--blue-primary);
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: transform var(--transition-fast);
}

.hero-card-footer .link:hover {
  transform: translateX(4px);
  color: var(--blue-hover);
}

/* --------------------------------------------------------------------------
   9. INNER PAGE HERO
   -------------------------------------------------------------------------- */
.page-hero {
  position: relative;
  background: linear-gradient(135deg, var(--navy-dark) 0%, var(--blue-dark) 45%, var(--blue-primary) 100%);
  color: #ffffff;
  padding: 75px 0 85px;
  overflow: hidden;
}

.page-hero::before {
  content: "";
  position: absolute;
  top: -100px;
  right: -100px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.2) 0%, transparent 70%);
  pointer-events: none;
}

.page-hero::after {
  content: "";
  position: absolute;
  bottom: -100px;
  left: -50px;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.page-hero .eyebrow {
  background: rgba(255, 255, 255, 0.15);
  color: #93c5fd;
  border-color: rgba(255, 255, 255, 0.25);
}

.page-hero h1 {
  color: #ffffff;
  font-size: clamp(34px, 4.5vw, 54px);
  margin: 12px 0;
  font-weight: 800;
}

.page-hero p {
  color: #dbeafe;
  font-size: 18px;
  max-width: 660px;
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   10. STATS COUNTER SECTION
   -------------------------------------------------------------------------- */
.stats {
  background: #ffffff;
  border-bottom: 1px solid var(--border);
  position: relative;
  z-index: 3;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 38px 0;
}

.stat {
  text-align: center;
  padding: 10px 24px;
  border-right: 1px solid var(--border);
  position: relative;
  transition: transform var(--transition-fast);
}

.stat:hover {
  transform: translateY(-3px);
}

.stat:last-child {
  border-right: none;
}

.stat-icon {
  font-size: 26px;
  margin-bottom: 6px;
  display: inline-block;
}

.stat strong {
  font-size: clamp(32px, 3.5vw, 44px);
  font-family: 'Outfit', sans-serif;
  color: var(--blue-primary);
  font-weight: 800;
  line-height: 1.1;
  display: block;
}

.stat span {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-muted);
  margin-top: 5px;
  display: block;
}

/* --------------------------------------------------------------------------
   11. SECTION HEADERS & GENERAL STYLES
   -------------------------------------------------------------------------- */
.section {
  padding: 90px 0;
  position: relative;
}

.section-alt {
  background-color: var(--surface-alt);
}

.section-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 50px;
}

.section-head h2 {
  font-size: clamp(30px, 3.5vw, 42px);
  color: var(--navy);
  margin: 12px 0 14px;
  font-weight: 800;
  letter-spacing: -0.3px;
}

.section-head p {
  color: var(--text-muted);
  font-size: 16.5px;
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   12. CARDS & GRID SYSTEMS
   -------------------------------------------------------------------------- */
.grid {
  display: grid;
  gap: 26px;
}

.courses {
  grid-template-columns: repeat(3, 1fr);
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 32px 28px;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-smooth);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* Glow line at top of card */
.card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--blue-primary), var(--accent-cyan));
  opacity: 0;
  transition: opacity var(--transition-fast);
}

.card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
  border-color: rgba(0, 102, 204, 0.25);
}

.card:hover::before {
  opacity: 1;
}

.card-badge {
  position: absolute;
  top: 20px;
  right: 20px;
  background: var(--blue-light);
  color: var(--blue-primary);
  font-size: 11.5px;
  font-weight: 800;
  padding: 4px 10px;
  border-radius: var(--radius-full);
}

.card-badge.popular {
  background: #fef3c7;
  color: #b45309;
}

.card-badge.accent {
  background: #dbeafe;
  color: #1d4ed8;
}

.icon {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--blue-light) 0%, #d4e8fd 100%);
  color: var(--blue-primary);
  display: grid;
  place-items: center;
  font-size: 24px;
  font-weight: 800;
  margin-bottom: 22px;
  transition: all var(--transition-smooth);
  box-shadow: 0 4px 10px rgba(0, 102, 204, 0.08);
}

.icon svg {
  width: 28px;
  height: 28px;
  fill: var(--blue-primary);
}

.card:hover .icon {
  transform: scale(1.1) rotate(4deg);
  background: linear-gradient(135deg, var(--blue-primary) 0%, #0099ff 100%);
  color: #ffffff;
}

.card:hover .icon svg {
  fill: #ffffff;
}

.card h3 {
  font-size: 21px;
  color: var(--navy);
  margin-bottom: 10px;
  font-weight: 700;
}

.card p {
  color: var(--text-muted);
  font-size: 14.5px;
  line-height: 1.6;
  flex-grow: 1;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 16px 0 8px;
  font-size: 12.5px;
  color: var(--text-muted);
  font-weight: 600;
}

.card-meta span {
  display: flex;
  align-items: center;
  gap: 4px;
}

.card .link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--blue-primary);
  font-weight: 700;
  margin-top: 18px;
  font-size: 14.5px;
  transition: all var(--transition-fast);
}

.card .link svg {
  width: 15px;
  height: 15px;
  transition: transform var(--transition-fast);
}

.card:hover .link {
  color: var(--blue-hover);
}

.card:hover .link svg {
  transform: translateX(5px);
}

/* --------------------------------------------------------------------------
   13. WHY CHOOSE BFA / FEATURES SECTION
   -------------------------------------------------------------------------- */
.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.feature-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 22px;
  text-align: center;
  transition: all var(--transition-smooth);
}

.feature-box:hover {
  transform: translateY(-6px);
  border-color: var(--blue-primary);
  box-shadow: var(--shadow-md);
}

.feature-box .feat-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--blue-light);
  color: var(--blue-primary);
  display: grid;
  place-items: center;
  margin: 0 auto 16px;
  font-size: 22px;
  transition: transform var(--transition-fast);
}

.feature-box:hover .feat-icon {
  transform: scale(1.15);
  background: var(--blue-primary);
  color: #ffffff;
}

.feature-box h4 {
  font-size: 17px;
  color: var(--navy);
  margin-bottom: 8px;
}

.feature-box p {
  font-size: 13.5px;
  color: var(--text-muted);
  line-height: 1.5;
}

/* --------------------------------------------------------------------------
   14. FILTER TABS (FOR COURSES & GALLERY)
   -------------------------------------------------------------------------- */
.filter-tabs {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 35px;
  flex-wrap: wrap;
}

.filter-btn {
  background: #ffffff;
  border: 1px solid var(--border);
  color: var(--text-main);
  padding: 9px 20px;
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.filter-btn:hover {
  border-color: var(--blue-primary);
  color: var(--blue-primary);
  background: var(--blue-light);
}

.filter-btn.active {
  background: var(--blue-primary);
  color: #ffffff;
  border-color: var(--blue-primary);
  box-shadow: 0 4px 14px rgba(0, 102, 204, 0.25);
}

/* --------------------------------------------------------------------------
   15. TESTIMONIALS SECTION
   -------------------------------------------------------------------------- */
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}

.testimonial-card {
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 30px 26px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: all var(--transition-smooth);
}

.testimonial-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: rgba(0, 102, 204, 0.2);
}

.testi-stars {
  color: #f59e0b;
  font-size: 16px;
  margin-bottom: 14px;
  letter-spacing: 2px;
}

.testi-quote {
  font-size: 14.5px;
  color: var(--text-main);
  font-style: italic;
  line-height: 1.6;
  margin-bottom: 22px;
}

.testi-author {
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--border-light);
  padding-top: 16px;
}

.testi-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue-primary), var(--accent-cyan));
  color: #ffffff;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 16px;
  flex-shrink: 0;
}

.testi-info strong {
  display: block;
  font-size: 14.5px;
  color: var(--navy);
}

.testi-info span {
  display: block;
  font-size: 12px;
  color: var(--text-muted);
}

/* --------------------------------------------------------------------------
   16. ABOUT PAGE COMPONENTS
   -------------------------------------------------------------------------- */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.about-box {
  background: linear-gradient(135deg, var(--surface-alt) 0%, #edf5fc 100%);
  border-radius: var(--radius-xl);
  padding: 44px 38px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.about-box::before {
  content: "";
  position: absolute;
  top: -50px;
  right: -50px;
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background: rgba(0, 102, 204, 0.08);
}

.about-box h2 {
  font-size: clamp(28px, 3.2vw, 38px);
  color: var(--navy);
  line-height: 1.2;
}

.about-box p {
  color: var(--text-muted);
  margin-top: 16px;
  font-size: 16px;
}

.list {
  list-style: none;
  margin-top: 24px;
}

.list li {
  padding: 12px 0;
  border-bottom: 1px solid #dce8f5;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 600;
  font-size: 15px;
  color: var(--navy);
}

.list li:last-child {
  border-bottom: none;
}

.list-check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--blue-light);
  color: var(--blue-primary);
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 12px;
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   17. ADMISSIONS & FEES
   -------------------------------------------------------------------------- */
.fees {
  grid-template-columns: repeat(3, 1fr);
}

.fee {
  position: relative;
  text-align: center;
  padding: 38px 28px;
}

.fee.featured-fee {
  border-color: var(--blue-primary);
  box-shadow: var(--shadow-lg);
  transform: scale(1.03);
}

.fee.featured-fee::before {
  opacity: 1;
  height: 6px;
}

.fee-tag {
  background: var(--blue-primary);
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 4px 14px;
  border-radius: var(--radius-full);
  display: inline-block;
  margin-bottom: 14px;
}

.price {
  font-size: 38px;
  font-family: 'Outfit', sans-serif;
  color: var(--blue-primary);
  font-weight: 800;
  margin: 14px 0 6px;
}

.price-sub {
  font-size: 13.5px;
  color: var(--text-muted);
  margin-bottom: 18px;
}

.fee-features {
  list-style: none;
  text-align: left;
  margin: 20px 0 25px;
  border-top: 1px solid var(--border-light);
  padding-top: 15px;
}

.fee-features li {
  padding: 8px 0;
  font-size: 13.5px;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 10px;
}

.fee-features li svg {
  width: 15px;
  height: 15px;
  fill: var(--accent-emerald);
  flex-shrink: 0;
}

/* Admission Steps Roadmap */
.steps-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
  margin-top: 35px;
  position: relative;
}

.step-card {
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px 18px;
  text-align: center;
  position: relative;
  transition: all var(--transition-smooth);
}

.step-card:hover {
  transform: translateY(-5px);
  border-color: var(--blue-primary);
  box-shadow: var(--shadow-md);
}

.step-num {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue-primary), var(--accent-cyan));
  color: #ffffff;
  font-family: 'Outfit', sans-serif;
  font-weight: 800;
  font-size: 18px;
  display: grid;
  place-items: center;
  margin: 0 auto 16px;
  box-shadow: 0 4px 12px rgba(0, 102, 204, 0.3);
}

.step-card h4 {
  font-size: 16px;
  color: var(--navy);
  margin-bottom: 6px;
}

.step-card p {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.4;
}

/* --------------------------------------------------------------------------
   18. GALLERY PAGE
   -------------------------------------------------------------------------- */
.gallery {
  grid-template-columns: repeat(3, 1fr);
}

.gallery-item {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: all var(--transition-smooth);
  background: var(--surface);
}

.gallery-item:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: rgba(0, 102, 204, 0.3);
}

.gallery-art {
  height: 220px;
  background: linear-gradient(135deg, #072a59 0%, #0066cc 60%, #00a2ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  padding: 20px;
  text-align: center;
}

.gallery-art::before {
  content: "";
  position: absolute;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  top: -40px;
  right: -30px;
}

.gallery-art-icon {
  font-size: 44px;
  margin-bottom: 10px;
  transition: transform var(--transition-smooth);
}

.gallery-item:hover .gallery-art-icon {
  transform: scale(1.15) rotate(5deg);
}

.gallery-overlay {
  position: absolute;
  inset: 0;
  background: rgba(4, 15, 35, 0.75);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  opacity: 0;
  transition: opacity var(--transition-fast);
  padding: 20px;
  text-align: center;
}

.gallery-item:hover .gallery-overlay {
  opacity: 1;
}

.gallery-overlay-btn {
  background: var(--blue-primary);
  color: #ffffff;
  padding: 8px 18px;
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 13px;
  margin-top: 10px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.gallery-info {
  padding: 18px 20px;
  background: #ffffff;
}

.gallery-info h4 {
  font-size: 17px;
  color: var(--navy);
  margin-bottom: 4px;
}

.gallery-info span {
  font-size: 12.5px;
  color: var(--text-muted);
  font-weight: 600;
}

/* Lightbox Modal */
.lightbox-modal {
  position: fixed;
  inset: 0;
  background: rgba(4, 15, 34, 0.88);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 30px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.lightbox-modal.active {
  display: flex;
  opacity: 1;
}

.lightbox-card {
  background: #ffffff;
  border-radius: var(--radius-xl);
  max-width: 650px;
  width: 100%;
  overflow: hidden;
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.lightbox-modal.active .lightbox-card {
  transform: scale(1);
}

.lightbox-header {
  height: 260px;
  background: linear-gradient(135deg, #072a59, #0066cc, #00d2ff);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 64px;
  position: relative;
}

.lightbox-close {
  position: absolute;
  top: 15px;
  right: 15px;
  background: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  display: grid;
  place-items: center;
  font-size: 20px;
  transition: background 0.2s;
  z-index: 10;
}

.lightbox-close:hover {
  background: rgba(0, 0, 0, 0.7);
}

.lightbox-body {
  padding: 26px 30px;
}

.lightbox-body h3 {
  font-size: 22px;
  color: var(--navy);
  margin-bottom: 8px;
}

.lightbox-body p {
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   19. FAQ ACCORDION
   -------------------------------------------------------------------------- */
.faq {
  max-width: 840px;
  margin: 0 auto;
}

.faq-item {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  margin: 14px 0;
  overflow: hidden;
  background: #ffffff;
  transition: all var(--transition-fast);
}

.faq-item:hover {
  border-color: rgba(0, 102, 204, 0.3);
}

.faq-item.open {
  border-color: var(--blue-primary);
  box-shadow: var(--shadow-sm);
}

.faq-q {
  padding: 20px 24px;
  font-weight: 700;
  font-size: 16.5px;
  color: var(--navy);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  user-select: none;
  transition: color var(--transition-fast);
}

.faq-q:hover {
  color: var(--blue-primary);
}

.faq-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--blue-light);
  color: var(--blue-primary);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s;
}

.faq-icon svg {
  width: 14px;
  height: 14px;
  fill: currentColor;
  transition: transform 0.3s;
}

.faq-item.open .faq-icon {
  background: var(--blue-primary);
  color: #ffffff;
  transform: rotate(180deg);
}

.faq-a-wrapper {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.faq-item.open .faq-a-wrapper {
  grid-template-rows: 1fr;
}

.faq-a {
  overflow: hidden;
}

.faq-a-inner {
  padding: 0 24px 22px;
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.65;
  border-top: 1px dashed var(--border-light);
  padding-top: 14px;
}

/* --------------------------------------------------------------------------
   20. CONTACT PAGE & FORMS
   -------------------------------------------------------------------------- */
.contact-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 32px;
}

.contact-card {
  padding: 38px 32px;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}

.contact-card h2 {
  font-size: 26px;
  color: var(--navy);
  margin-bottom: 8px;
}

.contact-card-sub {
  color: var(--text-muted);
  font-size: 14.5px;
  margin-bottom: 24px;
}

.contact-row {
  display: flex;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--border-light);
  align-items: flex-start;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-row-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: var(--blue-light);
  color: var(--blue-primary);
  display: grid;
  place-items: center;
  font-size: 20px;
  flex-shrink: 0;
}

.contact-row-icon svg {
  width: 20px;
  height: 20px;
  fill: var(--blue-primary);
}

.contact-row strong {
  display: block;
  color: var(--navy);
  font-size: 15px;
  margin-bottom: 4px;
}

.contact-row span, .contact-row a {
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.5;
}

.contact-row a:hover {
  color: var(--blue-primary);
}

.form {
  display: grid;
  gap: 18px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-label {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--navy);
}

.form input,
.form textarea,
.form select {
  width: 100%;
  padding: 14px 18px;
  border: 1.5px solid #ccdbea;
  border-radius: var(--radius-md);
  font: inherit;
  outline: none;
  background: #ffffff;
  transition: all var(--transition-fast);
  color: var(--text-main);
}

.form input:focus,
.form textarea:focus,
.form select:focus {
  border-color: var(--blue-primary);
  box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.12);
  background: #ffffff;
}

.form textarea {
  min-height: 130px;
  resize: vertical;
}

/* --------------------------------------------------------------------------
   21. CALL TO ACTION BAND
   -------------------------------------------------------------------------- */
.band {
  background: linear-gradient(135deg, var(--navy-dark) 0%, var(--blue-dark) 50%, var(--blue-primary) 100%);
  color: #ffffff;
  padding: 68px 0;
  position: relative;
  overflow: hidden;
}

.band::before {
  content: "";
  position: absolute;
  top: -120px;
  left: 20%;
  width: 350px;
  height: 350px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.18) 0%, transparent 70%);
}

.band-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  position: relative;
  z-index: 2;
}

.band h2 {
  font-size: clamp(28px, 3.5vw, 40px);
  color: #ffffff;
}

.band p {
  color: #c9dbf0;
  font-size: 17px;
  margin-top: 8px;
  max-width: 580px;
}

.band-actions {
  display: flex;
  gap: 14px;
  flex-shrink: 0;
  flex-wrap: wrap;
}

/* --------------------------------------------------------------------------
   22. FOOTER
   -------------------------------------------------------------------------- */
footer {
  background: var(--navy-dark);
  color: #c2d4ea;
  padding: 70px 0 30px;
  position: relative;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
  gap: 40px;
}

.footer-brand p {
  margin-top: 18px;
  font-size: 14.5px;
  line-height: 1.6;
  color: #94a9c4;
}

.footer-logo {
  height: 48px;
  width: auto;
  background: #ffffff;
  border-radius: var(--radius-sm);
  padding: 6px 10px;
  display: inline-block;
}

footer h3 {
  color: #ffffff;
  font-size: 17px;
  margin-bottom: 18px;
  font-weight: 700;
  position: relative;
  padding-bottom: 8px;
}

footer h3::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 28px;
  height: 2px;
  background: var(--blue-primary);
  border-radius: var(--radius-full);
}

footer a {
  display: block;
  margin: 10px 0;
  font-size: 14.5px;
  color: #9cb1cb;
  transition: all var(--transition-fast);
}

footer a:hover {
  color: #ffffff;
  transform: translateX(4px);
}

.footer-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 10px 0;
  font-size: 14px;
}

.footer-contact-item svg {
  width: 16px;
  height: 16px;
  fill: var(--accent-cyan);
  flex-shrink: 0;
  margin-top: 3px;
}

.copyright {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: 50px;
  padding-top: 25px;
  font-size: 13.5px;
  text-align: center;
  color: #728ba6;
}

/* --------------------------------------------------------------------------
   23. FLOATING ACTION WIDGETS
   -------------------------------------------------------------------------- */
/* WhatsApp Floating Widget */
.whatsapp-widget {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 12px;
}

.whatsapp-tooltip {
  background: #ffffff;
  color: var(--navy);
  padding: 8px 14px;
  border-radius: var(--radius-full);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  font-size: 13px;
  font-weight: 700;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 6px;
  animation: floatGentle 3s ease-in-out infinite;
  white-space: nowrap;
}

.whatsapp-btn {
  background: #25d366;
  color: #ffffff;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
  animation: radarPing 2.5s infinite;
  transition: transform var(--transition-fast);
  cursor: pointer;
}

.whatsapp-btn:hover {
  transform: scale(1.1);
  background: #1ebc59;
}

.whatsapp-btn svg {
  width: 32px;
  height: 32px;
  fill: #ffffff;
}

/* Scroll To Top Button */
.back-to-top {
  position: fixed;
  left: 24px;
  bottom: 24px;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: #ffffff;
  color: var(--blue-primary);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-md);
  display: grid;
  place-items: center;
  z-index: 990;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: all var(--transition-smooth);
}

.back-to-top.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.back-to-top:hover {
  background: var(--blue-primary);
  color: #ffffff;
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.back-to-top svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

/* Toast Notifications */
.toast-container {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.toast {
  background: #ffffff;
  color: var(--navy);
  padding: 14px 20px;
  border-radius: var(--radius-md);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18);
  border-left: 4px solid var(--blue-primary);
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12px;
  transform: translateX(120%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: auto;
}

.toast.show {
  transform: translateX(0);
}

.toast.success {
  border-left-color: #10b981;
}

/* --------------------------------------------------------------------------
   23b. INSTRUCTOR SPOTLIGHT (TEACHER QOSAIN SHAMIR)
   -------------------------------------------------------------------------- */
.instructor-card {
  background: linear-gradient(135deg, #ffffff 0%, #f4f9ff 100%);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 42px 38px;
  box-shadow: var(--shadow-lg);
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 40px;
  align-items: center;
  position: relative;
  overflow: hidden;
  transition: all var(--transition-smooth);
}

.instructor-card:hover {
  box-shadow: var(--shadow-xl);
  border-color: rgba(0, 102, 204, 0.35);
  transform: translateY(-4px);
}

.instructor-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, var(--blue-primary), var(--accent-cyan), #10b981);
}

.instructor-avatar-wrap {
  text-align: center;
  position: relative;
}

.instructor-avatar {
  width: 170px;
  height: 170px;
  border-radius: 50%;
  margin: 0 auto 18px;
  background: linear-gradient(145deg, #072a59 0%, #0066cc 55%, #00d2ff 100%);
  color: #ffffff;
  display: grid;
  place-items: center;
  font-family: 'Outfit', sans-serif;
  font-size: 52px;
  font-weight: 800;
  box-shadow: 0 16px 35px rgba(0, 102, 204, 0.32);
  border: 4px solid #ffffff;
  position: relative;
}

.instructor-avatar::after {
  content: "⭐";
  position: absolute;
  bottom: 4px;
  right: 8px;
  background: #f59e0b;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 3px solid #ffffff;
  font-size: 18px;
  display: grid;
  place-items: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
}

.instructor-title-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(0, 102, 204, 0.1);
  color: var(--blue-primary);
  padding: 5px 14px;
  border-radius: var(--radius-full);
  font-size: 12.5px;
  font-weight: 800;
  border: 1px solid rgba(0, 102, 204, 0.2);
}

.instructor-stats-row {
  display: flex;
  gap: 15px;
  margin-top: 18px;
  justify-content: center;
}

.instructor-stat-pill {
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  flex: 1;
}

.instructor-stat-pill strong {
  display: block;
  font-size: 20px;
  font-family: 'Outfit', sans-serif;
  color: var(--blue-primary);
  font-weight: 800;
  line-height: 1.1;
}

.instructor-stat-pill span {
  display: block;
  font-size: 11.5px;
  color: var(--text-muted);
  font-weight: 600;
}

.instructor-content h3 {
  font-size: 32px;
  color: var(--navy);
  margin-bottom: 6px;
}

.instructor-role {
  color: var(--blue-primary);
  font-weight: 700;
  font-size: 16px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.instructor-bio {
  color: var(--text-muted);
  font-size: 15.5px;
  line-height: 1.7;
  margin-bottom: 20px;
}

.instructor-highlights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 18px;
  margin-bottom: 25px;
}

.instructor-hl-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--navy);
}

.instructor-hl-item svg {
  width: 17px;
  height: 17px;
  fill: #10b981;
  flex-shrink: 0;
}

.instructor-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* Responsive for Instructor */
@media (max-width: 900px) {
  .instructor-card {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 32px 24px;
  }
  .instructor-highlights {
    grid-template-columns: 1fr;
    text-align: left;
  }
  .instructor-actions {
    justify-content: center;
  }
  .instructor-role {
    justify-content: center;
  }
}

/* --------------------------------------------------------------------------
   24. RESPONSIVE BREAKPOINTS
   -------------------------------------------------------------------------- */
@media (max-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .hero-art {
    min-height: 380px;
  }
  .courses, .fees, .gallery, .testimonials-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .steps-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .about-grid, .contact-grid {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .topbar-right {
    display: none;
  }
  .navlinks {
    position: fixed;
    top: 78px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 30px 8%;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transform: translateY(-120%);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 999;
    overflow-y: auto;
  }

  .navlinks.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .navlinks a {
    font-size: 18px;
    width: 100%;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-light);
  }

  .navlinks a::after {
    display: none;
  }

  .menu-btn {
    display: block;
  }

  .nav-actions .btn {
    display: none;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
    row-gap: 24px;
  }

  .stat:nth-child(2) {
    border-right: none;
  }
}

@media (max-width: 680px) {
  .topbar .container {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    font-size: 12px;
  }

  .hero {
    padding: 55px 0 65px;
  }

  .hero h1 {
    font-size: 34px;
  }

  .hero-subhead {
    font-size: 18px;
  }

  .hero-art {
    min-height: 320px;
    padding: 20px;
  }

  .cap-floating {
    font-size: 48px;
  }

  .floating-badge {
    display: none;
  }

  .courses, .fees, .gallery, .testimonials-grid {
    grid-template-columns: 1fr;
  }

  .features-grid, .steps-grid {
    grid-template-columns: 1fr;
  }

  .band-grid {
    flex-direction: column;
    align-items: flex-start;
  }

  .band-actions {
    width: 100%;
  }

  .band-actions .btn {
    width: 100%;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .whatsapp-tooltip {
    display: none;
  }
}
